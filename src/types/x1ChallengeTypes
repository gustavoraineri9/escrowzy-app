import { Database } from "../integrations/supabase/types";

// Tipos base do Supabase
export type X1ChallengeTable = Database["public"]["Tables"]["x1_challenges"]["Row"];
export type ProfileTable = Database["public"]["Tables"]["profiles"]["Row"];
export type FriendTable = Database["public"]["Tables"]["friends"]["Row"];

// Tipos de dados para o frontend, baseados nas definições do banco de dados

/**
 * Representa um desafio X1.
 */
export interface X1Challenge {
  id: string;
  challenger_id: string;
  challenged_id: string;
  game: string;
  bet_amount: number;
  status: 'pending' | 'accepted' | 'declined' | 'completed' | 'cancelled';
  created_at: string;
  updated_at: string;
  accepted_at: string | null;
  completed_at: string | null;
  winner_id: string | null;
}

/**
 * Representa um perfil de usuário.
 */
export interface Profile {
  id: string;
  auth_uid: string | null;
  email: string;
  full_name: string | null;
  display_name: string | null;
  created_at: string;
  updated_at: string;
  cpf: string | null;
  phone: string | null;
  avatar_url: string | null;
}

/**
 * Representa um registro de amizade.
 */
export interface Friend {
  id: string;
  user_id: string;
  friend_id: string;
  status: 'pending' | 'accepted' | 'blocked';
  created_at: string;
  updated_at: string;
}

// Tipos de entrada para criação/atualização
export interface CreateX1ChallengeData {
  challenger_id: string;
  challenged_id: string;
  game: string;
  bet_amount: number;
}

export interface UpdateX1ChallengeData {
  status?: 'pending' | 'accepted' | 'declined' | 'completed' | 'cancelled';
  winner_id?: string | null;
}
